    "id": "what-time-is-it",
    "title": "What Time Is It? How Data Geometry Makes Time Conditioning Optional for Flow Matching",
    "authors": [
      {
        "name": "Alec Helbling",
        "isHighlighted": true
      },
      {
        "name": "Sebastian Gutierrez Hernandez",
        "isHighlighted": false
      },
      {
        "name": "Benjamin Hoover",
